# TalentFlow currently runs in deterministic demo mode and requires no live AI secret.

# PostHog analytics - dedicated TalentFlow project, EU Cloud
# Webflow Cloud injects these variables at runtime.
# The PostHog project token is designed for browser use. Never place a PostHog personal API key here.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Webflow Cloud mount path
# Leave empty for the root environment. Use /beta for the beta environment.
# Manual browser fetch calls use this prefix so they resolve to the correct environment.
NEXT_PUBLIC_BASE_PATH=

# Public beta feedback delivery
# RESEND_API_KEY and FEEDBACK_FROM_EMAIL are server-side only and must never use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=TalentFlow <feedback@agence360digital.fr>
FEEDBACK_TO_EMAIL=sabrina.heydel@agence360digital.fr
