# TalentFlow currently runs in deterministic demo mode and requires no secret API key.

# PostHog analytics — dedicated TalentFlow project, EU Cloud
# The project token is a public client-side token. Never place a PostHog personal API key here.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
