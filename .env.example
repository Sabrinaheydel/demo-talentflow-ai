# TalentFlow currently runs in deterministic demo mode and requires no secret API key.

# PostHog analytics — dedicated TalentFlow project, EU Cloud
# Webflow Cloud injects these variables at runtime.
# The PostHog project token is designed for browser use. Never place a PostHog personal API key here.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
